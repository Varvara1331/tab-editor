{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "allowJs": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "strict": false,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "isolatedModules": false,
    "noEmit": true,
    "jsx": "react-jsx"
  },
  "include": [
    "frontend/src/**/*.ts",
    "frontend/src/**/*.tsx",
    "server/src/**/*.ts"
, "frontend/src/mocks/hyml2canvas.js", "frontend/src/mocks/jspdf.js"  ],
  "exclude": [
    "node_modules",
    "**/node_modules",
    "docs",
    "frontend/build",
    "server/dist",
    "**/*.test.ts",
    "**/*.spec.ts",
    "frontend/src/**/*.css",
    "frontend/src/**/*.scss",
    "frontend/src/**/*.svg",
    "frontend/src/**/*.png",
    "frontend/src/**/*.jpg"
  ]
}